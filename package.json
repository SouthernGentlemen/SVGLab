{
  "name": "svg-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local, deliberately unsafe 2D character animation laboratory.",
  "type": "module",
  "scripts": {
    "teardown": "node pipelines/dev/lifecycle.ts teardown",
    "reset": "node pipelines/dev/lifecycle.ts reset",
    "prebuild": "node pipelines/guards/local-only.ts",
    "build": "vite build",
    "check:rig": "node pipelines/guards/rig.ts",
    "build:parts": "node pipelines/sprite/build.ts",
    "check:sprites": "node pipelines/sprite/build.ts --check",
    "check:sockets": "node pipelines/guards/sockets.ts",
    "build:motions": "node pipelines/motion/build.ts",
    "check:motions": "node pipelines/motion/build.ts --check",
    "export:motions": "node pipelines/exchange/export.ts",
    "import:motions": "node pipelines/exchange/import.ts",
    "blender": "node pipelines/exchange/export.ts --blend",
    "check:exchange": "node pipelines/guards/exchange.ts",
    "check:footprint": "node pipelines/guards/footprint.ts",
    "check:blender": "node pipelines/guards/blender.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check:rig && npm run check:sprites && npm run check:sockets && npm run check:motions && npm run check:exchange && npm run build && npm run check:footprint && npm run typecheck && npm test && npm run check:blender"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "4.125.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260820.1": true
  }
}
