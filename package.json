{
  "name": "svg-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Disposable local combat and SVG animation laboratory.",
  "type": "module",
  "scripts": {
    "teardown": "node scripts/lifecycle.mjs teardown",
    "reset": "node scripts/lifecycle.mjs reset",
    "prebuild": "node scripts/assert-local-only.mjs",
    "build": "vite build",
    "build:characters": "node scripts/build-characters.mjs",
    "check:characters": "node scripts/build-characters.mjs --check",
    "build:motions": "node scripts/build-motions.mjs",
    "check:motions": "node scripts/build-motions.mjs --check",
    "export:motions": "node scripts/export-motions.mjs",
    "import:motions": "node scripts/import-motions.mjs",
    "check:exchange": "node scripts/check-motion-exchange.mjs",
    "launch": "node scripts/lifecycle.mjs launch",
    "dev": "node scripts/lifecycle.mjs dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check:motions && npm run check:exchange && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260911.1": true
  }
}
