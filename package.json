{
  "name": "svg-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local, deliberately unsafe 2D character animation laboratory.",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": { "node": "26.x", "npm": "11.x" },
  "scripts": {
    "teardown": "node pipelines/dev/lifecycle.ts teardown",
    "reset": "node pipelines/dev/lifecycle.ts reset",
    "launch": "node pipelines/dev/lifecycle.ts launch",
    "dev": "node pipelines/dev/lifecycle.ts dev",
    "prebuild": "node pipelines/guards/local-only.ts",
    "assert-local-only": "node pipelines/guards/local-only.ts",
    "build": "vite build",
    "build:motions": "node pipelines/motion/generate.ts",
    "check:motions": "node pipelines/motion/generate.ts --check",
    "check:footprint": "node pipelines/guards/footprint.ts",
    "check:cruft": "node pipelines/guards/cruft.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check",
    "check:history": "node pipelines/guards/history.ts",
    "test:history": "vitest run tests/guards/history.test.ts",
    "test:github-settings": "node --test tests/guards/github-settings.cases.mjs",
    "verify:github-settings": "node scripts/verify-github-settings.mjs",
    "check": "npm run check:history && npm run test:github-settings && npm run check:motions && npm run check:cruft && npm run build && npm run check:footprint && npm run typecheck && npm test --ignore-scripts && npm run assert-local-only"
  },
  "dependencies": {
    "boneyard": "file:../Boneyard"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "4.131.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260911.1": true
  }
}
