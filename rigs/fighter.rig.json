  "sockets": {
    "note": "A part must reach past the joint its child starts at, and the child must start above its own origin, so the two overlap and no background shows through. Measured across all 36 cross-sheet pairings of the three shipped sheets: 1.7 units minimum.",
    "minimumOverlap": 1.5,
    "maximumWidthStep": 6,
    "stepNote": "The child paints over the parent, so a narrower child leaves the parent's end showing. That reads as a taper up to about six units and as a broken limb past it. The guard reports; it does not resize art."
  },
  "wardrobe": {
    "note": "A cosmetic is art bound to an anchor and a depth slot, sized in rig units. It is never bound to a pixel offset in the sheet it was drawn on: the same authored offset lands in a different place on every figure, because it is multiplied by that figure's own part scale.",
    "required": [
      "kind"
    ],
    "optional": [
      "anchor",
      "layer",
      "height",
      "align",
      "rotate",
      "hides",
      "fitted",
      "mirror"
    ],
    "resolution": "A piece inherits its kind's defaults and overrides what it needs.",
    "hidesNote": "Naming a slot in `hides` drops that part's own art instead of painting over it, so nothing pokes out from under a helm. The guard checks the cosmetic actually covers what it hides.",
    "fittedNote": "A piece that only suits some figures lists them. There is no one-size-fits-all rig yet and the guard reports coverage rather than pretending otherwise.",
    "alignDefault": "centre",
    "kinds": {
      "hat": {
        "anchor": "head.crown",
        "layer": "over",
        "follows": "bone",
        "note": "Rides the head. Usually hides nothing; a full helm adds hides: [head]."
      },
      "mask": {
        "anchor": "head.face",
        "layer": "over",
        "follows": "bone",
        "note": "Rides the head, in front of the face."
      },
      "hair": {
        "anchor": "head.nape",
        "layer": "under",
        "follows": "bone",
        "note": "Behind the head art and in front of the torso."
      },
      "skirt": {
        "anchor": "pelvis.waist",
        "layer": "outer",
        "follows": "bone",
        "note": "Hangs from the pelvis and follows neither leg, so it does not shear when a knee bends."
      },
      "cloak": {
        "anchor": "torso.neck",
        "layer": "under",
        "follows": "bone",
        "note": "Behind the whole figure."
      },
      "pauldron": {
        "anchor": "torso.shoulder-front",
        "layer": "over",
        "follows": "bone",
        "mirror": "torso.shoulder-back",
        "note": "A mirrored pair, one per shoulder."
      },
      "belt": {
        "anchor": "pelvis.waist",
        "layer": "over",
        "follows": "bone",
        "note": "Rides the pelvis."
      }
    },
    "kindsNote": "Kinds are expected to be added and tweaked as pieces are drawn. That is a change to this file with a guard behind it, never a change to the renderer."
  },
  "depthProfiles": {
    "note": "Which arm crosses which body part, per clip. An imported clip inherits its origin's profile; a clip authored here with no origin is anatomical.",
    "profiles": {
      "anatomical": {
        "underLowerBody": null,
        "behindTorso": "far",
        "foreground": [
          "near"
        ],
        "head": "above-arms"
      },
      "locomotion": {
        "underLowerBody": "far",
        "behindTorso": null,
        "foreground": [
          "near"
        ],
        "head": "above-arms"
      },
      "both-front": {
        "underLowerBody": null,
        "behindTorso": null,
        "foreground": [
          "far",
          "near"
        ],
        "head": "above-arms"
      },
      "punch": {
        "underLowerBody": null,
        "behindTorso": null,
        "foreground": [
          "far",
          "near"
        ],
        "head": "below-arms"
      }
    },
    "sides": {
      "facingRight": {
        "arms": {
          "far": "arm-front",
          "near": "arm-back"
        },
        "legs": {
          "far": "leg-front",
          "near": "leg-back"
        }
      },
      "facingLeft": {
        "arms": {
          "far": "arm-back",
          "near": "arm-front"
        },
        "legs": {
          "far": "leg-back",
          "near": "leg-front"
        }
      }
    },
    "default": "anatomical"
  },
  "footprint": {
    "note": "Minimal is enforced as a direction, not as a number nobody chose on evidence. check:footprint records what everything weighs and fails when a number grows; accepting growth means committing the new baseline, which puts the increase in a diff where someone has to look at it.",
    "mode": "ratchet",
    "invariants": [
      "zero runtime dependencies",
      "art is never inlined into the bundle",
      "no raster reaches the shipped page"
    ],
    "baseline": "rigs/footprint.baseline.json"
  },
  "exchange": {
    "blender": {
      "axes": {
        "svg+x": "+X",
        "svg+y": "-Z",
        "depth": "+Y"
      },
      "unitScale": 1,
      "boneRoll": 0
    },
    "bvh": {
      "frameRate": 60,
      "frameTime": 0.0166667,
      "rootChannels": [
        "Xposition",
        "Yposition",
        "Zposition",
        "Zrotation",
        "Xrotation",
        "Yrotation"
      ],
      "jointChannels": [
        "Zrotation",
        "Xrotation",
        "Yrotation"
      ],
      "planarRotationChannel": "Zrotation",
      "rotationSign": -1,
      "rootOffset": [
        0,
        0,
        0
      ],
      "rootRestHeight": 42,
      "decimals": 6
    }
  },
  "naming": {
    "charset": "ascii",
    "separator": "-",
    "maxLength": 63,
    "note": "Blender's bone-name limit."
  }
}
