{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svglab.local/rigs/figure.schema.json",
  "title": "SVGLab figure manifest",
  "description": "A complete selection of rig parts and fitted cosmetics. render:figure validates referenced files, bone ids, wardrobe declarations, and fit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "name",
    "rig",
    "parts",
    "cosmetics"
  ],
  "properties": {
    "contract": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rig": {
      "const": "fighter",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_lower_l",
        "arm_lower_r",
        "arm_upper_l",
        "arm_upper_r",
        "head",
        "leg_lower_l",
        "leg_lower_r",
        "leg_upper_l",
        "leg_upper_r",
        "pelvis",
        "torso"
      ],
      "properties": {
        "arm_lower_l": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/arm_lower_l\\.svg$"
        },
        "arm_lower_r": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/arm_lower_r\\.svg$"
        },
        "arm_upper_l": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/arm_upper_l\\.svg$"
        },
        "arm_upper_r": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/arm_upper_r\\.svg$"
        },
        "head": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/head\\.svg$"
        },
        "leg_lower_l": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/leg_lower_l\\.svg$"
        },
        "leg_lower_r": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/leg_lower_r\\.svg$"
        },
        "leg_upper_l": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/leg_upper_l\\.svg$"
        },
        "leg_upper_r": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/leg_upper_r\\.svg$"
        },
        "pelvis": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/pelvis\\.svg$"
        },
        "torso": {
          "type": "string",
          "pattern": "^characters/[a-z][a-z0-9-]*/parts/torso\\.svg$"
        }
      }
    },
    "cosmetics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^cosmetics/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*\\.svg$"
      }
    }
  }
}
