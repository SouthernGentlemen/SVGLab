{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svg-lab-local-only",
  "main": "src/shell/worker.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
